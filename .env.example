# Database
DATABASE_URL="postgres://darts:darts@localhost:5432/darts"
# TEST_DATABASE_URL overrides the test DB connection (defaults to localhost:5432/darts_test).
# Set to localhost:5433/darts_test when running the docker-compose db_test service.
TEST_DATABASE_URL=""

# NextAuth
AUTH_SECRET=""               # generate: openssl rand -base64 32
AUTH_URL="http://localhost:3000"

# UploadThing
UPLOADTHING_TOKEN=""         # from https://uploadthing.com dashboard
