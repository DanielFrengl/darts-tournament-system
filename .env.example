# Database
# Local:   postgres://darts:darts@localhost:5432/darts
# Railway: provided automatically as ${{ Postgres.DATABASE_URL }} when you
#          attach a Postgres plugin. Use the internal hostname (ends in
#          `.railway.internal`) for lower latency.
DATABASE_URL="postgres://darts:darts@localhost:5432/darts"
# Force SSL off (e.g. local docker). Leave unset in production — the client
# auto-enables SSL for non-internal hosts in production.
# PGSSLMODE="disable"
# TEST_DATABASE_URL overrides the test DB connection (defaults to localhost:5432/darts_test).
# Set to localhost:5433/darts_test when running the docker-compose db_test service.
TEST_DATABASE_URL=""

# NextAuth
AUTH_SECRET=""               # generate: openssl rand -base64 32
# In production set this to the public URL of the app
# (e.g. https://darts.up.railway.app). NextAuth `trustHost: true` is enabled
# so AUTH_URL is optional, but setting it is recommended.
AUTH_URL="http://localhost:3000"

# UploadThing (optional — avatar/logo uploads disabled if unset)
UPLOADTHING_TOKEN=""         # from https://uploadthing.com dashboard

# Node env — Railway sets this to "production" automatically.
# NODE_ENV="production"
